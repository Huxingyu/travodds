@PACKAGE_INIT@
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/travodds-static-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/travodds-static-targets.cmake")
    add_library(TRAVODDS::TRAVODDS_STATIC ALIAS TRAVODDS::travoddsstatic)
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/travodds-shared-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/travodds-shared-targets.cmake")
    add_library(TRAVODDS::TRAVODDS ALIAS TRAVODDS::travodds)
endif()

set(TRAVODDS_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/@INCLUDE_INSTALL_DIR@")

set(TRAVODDS_LIBRARIES_DIRS "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@")

include(CMakeFindDependencyMacro)
